<section class="py-5 bg-white" id="events">
  <div class="container">
    <!-- Section Title -->
    <div class="text-center mb-5">
      <div class="d-inline-block position-relative">
        <span class="text-primary-custom fw-normal fs-6 px-4 position-relative">
          Eventos
        </span>
      </div>
      <h2 class="display-5 fw-bold text-dark mt-3 mb-0">Próximos Eventos</h2>
    </div>

    <!-- Events Grid -->
    <div class="row g-4">
      <% @events&.each do |event| %>
        <div class="col-sm-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm bg-white">
            <!-- Event Image (First image found) -->
            <% if event.images.attached? %>
              <% first_image = event.images.find { |img| img.blob.content_type.start_with?("image/") } %>
              <% if first_image %>
                <div class="position-relative overflow-hidden" style="height: 200px;">
                  <%= image_tag first_image,
                                class: "card-img-top w-100 h-100",
                                style: "object-fit: cover;" %>
                </div>
              <% end %>
            <% end %>

            <div class="card-body p-4">
              <h3 class="card-title h5 fw-bold text-dark mb-3 lh-base"><%= event.name %></h3>
              <div class="mb-3">
                <div class="d-flex align-items-center mb-2">
                  <i class="fas fa-map-marker-alt text-primary-custom me-2 flex-shrink-0"></i>
                  <small class="text-muted"><%= event.location %></small>
                </div>
                <div class="d-flex align-items-center mb-3">
                  <i class="fas fa-calendar-alt text-primary-custom me-2 flex-shrink-0"></i>
                  <small class="text-muted"><%= I18n.l(event.date, format: :short) %></small>
                </div>
              </div>
              <p class="text-muted small mb-4 lh-base">
                <%= truncate(event.description, length: 80) %>
              </p>
              <button type="button" class="btn btn-outline-primary btn-sm rounded-pill w-100" data-bs-toggle="modal" data-bs-target="#eventModal<%= event.id %>">
                Ver detalhes
              </button>
            </div>
          </div>
        </div>

        <!-- Modal -->
        <div class="modal fade" id="eventModal<%= event.id %>" tabindex="-1" aria-labelledby="eventModalLabel<%= event.id %>" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow">
              <div class="modal-header border-0 pb-2 bg-secondary-custom">
                <h5 class="modal-title fw-bold text-dark" id="eventModalLabel<%= event.id %>"><%= event.name %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body">
                <div class="mb-3">
                  <div class="d-flex align-items-start mb-2">
                    <i class="fas fa-map-marker-alt text-primary-custom me-3 mt-1 flex-shrink-0"></i>
                    <div>
                      <strong class="text-dark d-block small">Localização:</strong>
                      <span class="text-muted"><%= event.location %></span>
                    </div>
                  </div>
                </div>
                <div class="mb-3">
                  <div class="d-flex align-items-start mb-2">
                    <i class="fas fa-calendar-alt text-primary-custom me-3 mt-1 flex-shrink-0"></i>
                    <div>
                      <strong class="text-dark d-block small">Data:</strong>
                      <span class="text-muted"><%= I18n.l(event.date, format: :long) %></span>
                    </div>
                  </div>
                </div>
                <div class="mb-3">
                  <div class="d-flex align-items-start">
                    <i class="fas fa-info-circle text-primary-custom me-3 mt-1 flex-shrink-0"></i>
                    <div>
                      <strong class="text-dark d-block small mb-2">Descrição:</strong>
                      <p class="text-muted mb-0 lh-base"><%= event.description %></p>
                    </div>
                  </div>
                </div>

                <!-- Images/Videos Carousel -->
                <% if event.images.attached? && event.images.count > 0 %>
                  <div class="mb-3">
                    <div class="d-flex align-items-start">
                      <i class="fas fa-images text-primary-custom me-3 mt-1 flex-shrink-0"></i>
                      <div class="w-100">
                        <strong class="text-dark d-block small mb-2">Mídia:</strong>

                        <% if event.images.count == 1 %>
                          <!-- Single image/video - no carousel needed -->
                          <% media = event.images.first %>
                          <div class="text-center">
                            <% if media.blob.content_type.start_with?("image/") %>
                              <%= image_tag media, class: "img-fluid rounded", style: "max-height: 300px;" %>
                            <% elsif media.blob.content_type.start_with?("video/") %>
                              <%= video_tag url_for(media),
                                            controls: true,
                                            preload: "metadata",
                                            class: "rounded",
                                            style: "max-height: 300px; max-width: 100%;" %>
                            <% end %>
                          </div>
                        <% else %>
                          <!-- Multiple images/videos - use carousel -->
                          <div id="eventCarousel<%= event.id %>" class="carousel slide" data-bs-ride="carousel">
                            <!-- Carousel Indicators -->
                            <div class="carousel-indicators">
                              <% event.images.each_with_index do |media, index| %>
                                <button type="button"
                                        data-bs-target="#eventCarousel<%= event.id %>"
                                        data-bs-slide-to="<%= index %>"
                                        <%= 'class="active" aria-current="true"'.html_safe if index == 0 %>
                                        aria-label="Slide <%= index + 1 %>"></button>
                              <% end %>
                            </div>

                            <!-- Carousel Items -->
                            <div class="carousel-inner rounded">
                              <% event.images.each_with_index do |media, index| %>
                                <div class="carousel-item <%= 'active' if index == 0 %>">
                                  <div class="d-flex justify-content-center align-items-center" style="height: 300px; background-color: #f8f9fa;">
                                    <% if media.blob.content_type.start_with?("image/") %>
                                      <%= image_tag media,
                                                    class: "d-block img-fluid",
                                                    style: "max-height: 100%; max-width: 100%; object-fit: contain;" %>
                                    <% elsif media.blob.content_type.start_with?("video/") %>
                                      <%= video_tag url_for(media),
                                                    controls: true,
                                                    preload: "metadata",
                                                    style: "max-height: 100%; max-width: 100%;" %>
                                    <% end %>
                                  </div>
                                </div>
                              <% end %>
                            </div>

                            <!-- Carousel Controls -->
                            <button class="carousel-control-prev" type="button" data-bs-target="#eventCarousel<%= event.id %>" data-bs-slide="prev"
                                    style="width: 30px; height: 30px; background: rgba(248,249,250,0.9); border-radius: 50%;
                                      position: absolute; top: 50%; left: 15px; transform: translateY(-50%);
                                      border: none; box-shadow: 0 2px 8px rgba(0,0,0,0.2);">
                              <i class="fas fa-chevron-left" style="color: #333; font-size: 18px;"></i>
                              <span class="visually-hidden">Anterior</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#eventCarousel<%= event.id %>" data-bs-slide="next"
                                    style="width: 30px; height: 30px; background: rgba(248,249,250,0.9); border-radius: 50%;
                                      position: absolute; top: 50%; right: 15px; transform: translateY(-50%);
                                      border: none; box-shadow: 0 2px 8px rgba(0,0,0,0.2);">
                              <i class="fas fa-chevron-right" style="color: #333; font-size: 18px;"></i>
                              <span class="visually-hidden">Próximo</span>
                            </button>

                            <!-- Media counter -->
                            <div class="position-absolute top-0 end-0 m-2">
                              <span class="badge bg-dark bg-opacity-75 rounded-pill">
                                <i class="fas fa-images me-1"></i>
                                <%= event.images.count %>
                              </span>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
              <div class="modal-footer border-0 bg-secondary-custom">
                <button type="button" class="btn btn-secondary btn-sm rounded-pill" data-bs-dismiss="modal">Fechar</button>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>