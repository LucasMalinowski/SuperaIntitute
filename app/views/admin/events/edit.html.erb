<% content_for :page_title, "Editar Evento" %>
<% content_for :breadcrumb do %>
	<ol class="breadcrumb">
		<li class="breadcrumb-item"><%= link_to "Dashboard", admin_root_path %></li>
		<li class="breadcrumb-item"><%= link_to "Eventos", admin_events_path %></li>
		<li class="breadcrumb-item"><%= link_to @event.name, admin_event_path(@event) %></li>
		<li class="breadcrumb-item active">Editar</li>
	</ol>
<% end %>

<div class="row justify-content-center">
	<div class="col-md-8">
		<div class="card">
			<div class="card-header">
				<h5 class="mb-0">Editar Evento</h5>
			</div>
			<div class="card-body">
				<%= render "form", event: @event %>
			</div>
		</div>
	</div>
</div>
