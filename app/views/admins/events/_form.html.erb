<div class="container">

  <%= form_with(model: @admins_event, local: true) do |form| %>
    <% if @admins_event.errors.any? %>
      <div class="alert alert-danger">
        <h2><%= pluralize(@admins_event.errors.count, "erro") %> impedem este evento de ser salvo:</h2>
        <ul>
          <% @admins_event.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-3">
      <%= form.label :name %>
      <%= form.text_field :name, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= form.label :description %>
      <%= form.text_area :description, class: "form-control", rows: 3, required: true %>
    </div>

    <div class="mb-3">
      <%= form.label :date %>
      <%= form.datetime_field :date, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= form.label :location %>
      <%= form.text_field :location, class: "form-control", required: true %>
    </div>

    <div class="d-grid gap-2">
      <%= form.submit class: "btn btn-dark" %>
    </div>
  <% end %>

  <div class="mt-4">
    <%= link_to t('buttons.back_to_events'), admins_events_path, class: "btn btn-outline-dark" %>
  </div>
</div>
