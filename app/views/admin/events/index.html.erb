<% content_for :page_title, "Eventos" %>
<% content_for :breadcrumb do %>
	<ol class="breadcrumb">
		<li class="breadcrumb-item"><%= link_to "Dashboard", admin_root_path %></li>
		<li class="breadcrumb-item active">Eventos</li>
	</ol>
<% end %>

<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<p class="text-muted mb-0">Gerencie todos os eventos do sistema</p>
	</div>
	<%= link_to new_admin_event_path, class: "btn btn-primary" do %>
		<i class="bi bi-plus-lg me-2"></i>Novo Evento
	<% end %>
</div>

<div class="card">
	<div class="card-body">
		<% if @events.any? %>
			<div class="table-responsive">
				<table class="table table-hover">
					<thead>
					<tr>
						<th>Nome</th>
						<th>Data</th>
						<th>Local</th>
						<th>Status</th>
						<th>Criado por</th>
						<th class="text-end">Ações</th>
					</tr>
					</thead>
					<tbody>
					<% @events.each do |event| %>
						<tr>
							<td>
								<strong><%= event.name %></strong>
								<br>
								<small class="text-muted"><%= truncate(event.description, length: 60) %></small>
							</td>
							<td>
								<%= event.formatted_date %>
							</td>
							<td><%= event.location %></td>
							<td>
								<% if event.published? %>
									<span class="badge bg-success">Publicado</span>
								<% else %>
									<span class="badge bg-secondary">Rascunho</span>
								<% end %>
								<br>
								<span class="badge bg-<%= event.upcoming? ? 'primary' : 'secondary' %> mt-1">
									<%= event.upcoming? ? 'Próximo' : 'Passado' %>
								</span>
							</td>
							<td><%= event.creator.display_name %></td>
							<td class="text-end">
								<div class="btn-group" role="group">
									<%= link_to admin_event_path(event), class: "btn btn-sm btn-outline-primary" do %>
										<i class="bi bi-eye"></i>
									<% end %>
									<%= link_to edit_admin_event_path(event), class: "btn btn-sm btn-outline-secondary" do %>
										<i class="bi bi-pencil"></i>
									<% end %>
									<%= link_to admin_event_path(event), method: :delete,
															data: { confirm: "Tem certeza que deseja excluir este evento?" },
															class: "btn btn-sm btn-outline-danger" do %>
										<i class="bi bi-trash"></i>
									<% end %>
								</div>
							</td>
						</tr>
					<% end %>
					</tbody>
				</table>
			</div>
		<% else %>
			<div class="text-center py-5">
				<i class="bi bi-calendar-x" style="font-size: 4rem; color: var(--admin-secondary);"></i>
				<h4 class="mt-3">Nenhum evento encontrado</h4>
				<p class="text-muted mb-4">Comece criando seu primeiro evento</p>
				<%= link_to new_admin_event_path, class: "btn btn-primary" do %>
					<i class="bi bi-plus-lg me-2"></i>Criar Evento
				<% end %>
			</div>
		<% end %>
	</div>
</div>

