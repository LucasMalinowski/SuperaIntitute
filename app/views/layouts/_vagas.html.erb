<section class="pricing section-padding" id="pricing">
<div class="container">
  <div class="section-title">
    <span class="title">vagas</span>
    <h2 class="sub-title">vagas disponíveis</h2>
  </div>
    <div class="grid">
      <% @roles.each do |role| %>
        <div class="pricing-item">
          <div class="pricing-header">
            <h3><%= role.name %></h3>
            <div class="price"><span> <%= number_to_currency(role.salary) %></span><%= role.company %></div>
          </div>
          <div class="pricing-body">
            <% JSON.parse(role.benefits).each_with_index do |benefit, index| %>
              <ul>
                <% if index == 3 %>
                  <li><i class="fas fa-check"></i>...</li>
                <% elsif index < 3 %>
                  <li><i class="fas fa-check"></i> <%= benefit %></li>
                <% end %>
              </ul>
            <% end %>
          </div>
          <div class="pricing-footer">
            <a href="#" class="btn" >+ informações</a>
          </div>
        </div>
      <% end %>
    </div>
</div>
</section>