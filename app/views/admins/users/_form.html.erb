<%= form_with(model: user, url: admins_create_user_path, method: :post) do |form| %>
<!--  div for errors-->
  <% if @user.errors.any? %>
    <div>
      <h2><%= pluralize(@user.errors.count, "error") %> impediram esse usuario de ser salvo:</h2>
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label "Nome", style: "display: block" %>
    <%= form.text_field :name %>
  </div>
  <div>
    <%= form.label :email, style: "display: block" %>
    <%= form.text_field :email %>
  </div>
  <div>
    <%= form.label "Senha", style: "display: block" %>
    <%= form.text_field :password %>
  </div>
  <div>
    <%= form.label "Confirmação de senha", style: "display: block" %>
    <%= form.text_field :password_confirmation %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
