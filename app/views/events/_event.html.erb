<article class="card" id="event-<%= event.id %>">
  <% if event.image.attached? %>
    <%= image_tag event.image.variant(resize_to_limit: [600, 400]), class: 'w-full h-40 object-cover' %>
  <% end %>
  <div class="p-4">
    <h2 class="text-xl font-semibold mb-2">
      <%= link_to event.name, event_path(event) %>
    </h2>
    <p class="text-gray-600 dark:text-gray-400 mb-2">
      <time datetime="<%= event.starts_at.iso8601 %>"><%= l(event.starts_at, format: :long) %></time>
    </p>
    <p class="text-gray-700 dark:text-gray-300"><%= truncate(event.description.to_plain_text, length: 120) %></p>
    <div class="mt-4">
      <%= link_to t('navigation.events'), event_path(event), class: 'btn-primary' %>
    </div>
  </div>
</article>