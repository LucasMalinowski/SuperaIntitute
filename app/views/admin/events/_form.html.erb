<%= form_with(model: [:admin, event], local: true, html: { multipart: true }) do |form| %>
  <% if event.errors.any? %>
    <div class="alert alert-danger">
      <h6><i class="bi bi-exclamation-triangle me-2"></i>Corrija os seguintes erros:</h6>
      <ul class="mb-0">
        <% event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label fw-semibold" %>
    <%= form.text_field :name, class: "form-control #{'is-invalid' if event.errors[:name].any?}",
                        placeholder: "Nome do evento" %>
    <% if event.errors[:name].any? %>
      <div class="invalid-feedback">
        <%= event.errors[:name].first %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label fw-semibold" %>
    <%= form.text_area :description, class: "form-control #{'is-invalid' if event.errors[:description].any?}",
                       rows: 4, placeholder: "Descrição detalhada do evento" %>
    <% if event.errors[:description].any? %>
      <div class="invalid-feedback">
        <%= event.errors[:description].first %>
      </div>
    <% end %>
  </div>

  <div class="row">
    <div class="col-md-6">
      <div class="mb-3">
        <%= form.label :date, class: "form-label fw-semibold" %>
        <%= form.datetime_local_field :date, class: "form-control #{'is-invalid' if event.errors[:date].any?}" %>
        <% if event.errors[:date].any? %>
          <div class="invalid-feedback">
            <%= event.errors[:date].first %>
          </div>
        <% end %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="mb-3">
        <%= form.label :location, class: "form-label fw-semibold" %>
        <%= form.text_field :location, class: "form-control #{'is-invalid' if event.errors[:location].any?}",
                            placeholder: "Local do evento" %>
        <% if event.errors[:location].any? %>
          <div class="invalid-feedback">
            <%= event.errors[:location].first %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :images, class: "form-label fw-semibold" %>
    <%= form.file_field :images,
                        multiple: true,
                        direct_upload: true,
                        accept: "image/*,video/*",
                        class: "form-control #{'is-invalid' if event.errors[:images].any?}" %>
    <div class="form-text">Você pode selecionar várias imagens (JPEG, PNG, GIF, WebP). Máx 5MB cada.</div>
    <% if event.errors[:images].any? %>
      <div class="invalid-feedback"><%= event.errors[:images].first %></div>
    <% end %>
  </div>

  <% if event.images.attached? %>
    <div class="mb-3 d-flex flex-wrap gap-3">
      <% event.images.each do |att| %>
        <div class="border rounded p-2 text-center" style="width: 180px;">
          <% if att.blob.content_type.start_with?("image/") %>
            <%= image_tag att, class: "img-fluid rounded" %>
          <% elsif att.blob.content_type.start_with?("video/") %>
            <%= video_tag url_for(att),
                          controls: true,
                          preload: "metadata",
                          width: 180,
                          class: "rounded" %>
          <% end %>

          <div class="mt-2 d-flex justify-content-center">
            <%= link_to "Remover",
                        admin_attachment_path(att.id),
                        data: { turbo_method: :delete, turbo_confirm: "Remover este arquivo?" },
                        class: "btn btn-sm btn-outline-danger" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="mb-4">
    <div class="form-check form-switch">
      <%= form.check_box :published, class: "form-check-input" %>
      <%= form.label :published, "Publicar evento", class: "form-check-label" %>
      <div class="form-text">Eventos publicados ficam visíveis no site</div>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit event.persisted? ? "Atualizar Evento" : "Criar Evento",
                    class: "btn btn-primary" %>
    <%= link_to "Cancelar", admin_events_path, class: "btn btn-secondary" %>
  </div>
<% end %>
