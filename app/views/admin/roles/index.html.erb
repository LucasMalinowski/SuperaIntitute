<% content_for :page_title, "Vagas" %>
<% content_for :breadcrumb do %>
	<ol class="breadcrumb">
		<li class="breadcrumb-item"><%= link_to "Dashboard", admin_root_path %></li>
		<li class="breadcrumb-item active">Vagas</li>
	</ol>
<% end %>

<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<p class="text-muted mb-0">Gerencie todas as vagas disponíveis</p>
	</div>
	<%= link_to new_admin_role_path, class: "btn btn-primary" do %>
		<i class="bi bi-plus-lg me-2"></i>Nova Vaga
	<% end %>
</div>

<div class="card">
	<div class="card-body">
		<% if @roles.any? %>
			<div class="table-responsive">
				<table class="table table-hover">
					<thead>
					<tr>
						<th>Posição</th>
						<th>Empresa</th>
						<th>Local</th>
						<th>Salário</th>
						<th>Status</th>
						<th>Criado por</th>
						<th class="text-end">Ações</th>
					</tr>
					</thead>
					<tbody>
					<% @roles.each do |role| %>
						<tr>
							<td>
								<strong><%= role.name %></strong>
								<br>
								<small class="text-muted"><%= truncate(role.description, length: 60) %></small>
							</td>
							<td><%= role.company %></td>
							<td><%= role.location %></td>
							<td>
								<span class="badge bg-warning text-dark"><%= role.formatted_salary %></span>
							</td>
							<td>
								<% if role.published? %>
									<span class="badge bg-success">Publicada</span>
								<% else %>
									<span class="badge bg-secondary">Rascunho</span>
								<% end %>
							</td>
							<td><%= role.creator.display_name %></td>
							<td class="text-end">
								<div class="d-flex gap-1" role="group">
									<%= link_to admin_role_path(role), class: "btn btn-sm btn-outline-primary" do %>
										<i class="bi bi-eye"></i>
									<% end %>
									<%= link_to edit_admin_role_path(role), class: "btn btn-sm btn-outline-secondary" do %>
										<i class="bi bi-pencil"></i>
									<% end %>
									<%= button_to admin_role_path(role), method: :delete,
															data: { confirm: "Tem certeza que deseja excluir esta vaga?" },
															class: "btn btn-sm btn-outline-danger" do %>
										<i class="bi bi-trash"></i>
									<% end %>
								</div>
							</td>
						</tr>
					<% end %>
					</tbody>
				</table>
			</div>
		<% else %>
			<div class="text-center py-5">
				<i class="bi bi-briefcase-x" style="font-size: 4rem; color: var(--admin-secondary);"></i>
				<h4 class="mt-3">Nenhuma vaga encontrada</h4>
				<p class="text-muted mb-4">Comece criando sua primeira vaga</p>
				<%= link_to new_admin_role_path, class: "btn btn-primary" do %>
					<i class="bi bi-plus-lg me-2"></i>Criar Vaga
				<% end %>
			</div>
		<% end %>
	</div>
</div>
