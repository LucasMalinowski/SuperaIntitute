<article class="card">
  <% if event.image.attached? %>
    <%= image_tag event.image.variant(resize_to_limit: [600, 400]), class: 'w-full h-40 object-cover' %>
  <% end %>
  <div class="p-4">
    <h2 class="text-xl font-semibold mb-2"><%= link_to event.name, admin_event_path(event) %></h2>
    <p class="text-gray-600 dark:text-gray-400 mb-2"><%= l(event.starts_at, format: :long) %></p>
    <p class="text-sm mb-4"><%= truncate(event.description.to_plain_text, length: 100) %></p>
    <div class="flex space-x-2">
      <%= link_to t('buttons.edit'), edit_admin_event_path(event), class: 'btn-secondary' %>
      <%= button_to t('buttons.delete'), admin_event_path(event), method: :delete, data: { turbo_confirm: t('buttons.confirm_destroy') }, class: 'btn-secondary' %>
    </div>
  </div>
</article>