<%= form_with(model: user, url: user.persisted? ? admins_update_user_path(user) : admins_create_user_path, method: user.persisted? ? :patch : :post) do |form| %>
  <div>
    <%= form.label "Nome", style: "display: block" %>
    <%= form.text_field :name %>
  </div>
  <div>
    <%= form.label :email, style: "display: block" %>
    <%= form.text_field :email %>
  </div>
  <div>
    <%= form.label "Senha", style: "display: block", class: user.persisted? ? "hidden" : "" %>
    <%= form.text_field :password, class: user.persisted? ? "hidden" : "" %>
  </div>
  <div>
    <%= form.label "Confirmação de senha", style: "display: block", class: user.persisted? ? "hidden" : "" %>
    <%= form.text_field :password_confirmation, class: user.persisted? ? "hidden" : "" %>
  </div>
  <div>
    <%= form.submit user.persisted? ? "Atualizar Usuário" : "Criar Usuário" %>
  </div>
<% end %>

<div>
  <%= link_to "Voltar para Usuários", admins_users_path %>
</div>
