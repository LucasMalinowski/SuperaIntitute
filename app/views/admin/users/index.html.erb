<% content_for :page_title, "Usuários" %>
<% content_for :breadcrumb do %>
	<ol class="breadcrumb">
		<li class="breadcrumb-item"><%= link_to "Dashboard", admin_root_path %></li>
		<li class="breadcrumb-item active">Usuários</li>
	</ol>
<% end %>

<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<p class="text-muted mb-0">Gerencie todos os usuários do sistema</p>
	</div>
	<%= link_to new_admin_user_path, class: "btn btn-primary" do %>
		<i class="bi bi-plus-lg me-2"></i>Novo Usuário
	<% end %>
</div>

<div class="card">
	<div class="card-body">
		<% if @users.any? %>
			<div class="table-responsive">
				<table class="table table-hover">
					<thead>
					<tr>
						<th>Nome</th>
						<th>Email</th>
						<th>Papel</th>
						<th>Criado em</th>
						<th class="text-end">Ações</th>
					</tr>
					</thead>
					<tbody>
					<% @users.each do |user| %>
						<tr>
							<td>
								<strong><%= "#{user.display_name}" "#{current_user == user ? " (Você)": ""}" %></strong>
							</td>
							<td><%= user.email %></td>
							<td>
                  <span class="badge bg-<%= user.admin? ? 'danger' : 'primary' %>">
										<%= user.admin? ? 'Admin' : 'Usuário' %>
									</span>
							</td>
							<td><%= user.created_at.strftime('%d/%m/%Y') %></td>
							<td class="text-end">
								<div class="d-flex gap-1" role="group">
									<%= link_to edit_admin_user_path(user), class: "btn btn-sm btn-outline-secondary" do %>
										<i class="bi bi-pencil"></i>
									<% end %>
									<% unless user == current_user %>
										<%= button_to admin_user_path(user), method: :delete,
																data: { confirm: "Tem certeza que deseja excluir este usuário?" },
																class: "btn btn-sm btn-outline-danger" do %>
											<i class="bi bi-trash"></i>
										<% end %>

									<% end %>
								</div>
							</td>
						</tr>
					<% end %>
					</tbody>
				</table>
			</div>
		<% else %>
			<div class="text-center py-5">
				<i class="bi bi-people-x" style="font-size: 4rem; color: var(--admin-secondary);"></i>
				<h4 class="mt-3">Nenhum usuário encontrado</h4>
				<p class="text-muted mb-4">Comece criando o primeiro usuário</p>
				<%= link_to new_admin_user_path, class: "btn btn-primary" do %>
					<i class="bi bi-plus-lg me-2"></i>Criar Usuário
				<% end %>
			</div>
		<% end %>
	</div>
</div>

