<% content_for :page_title, "Editar Usuário" %>
<% content_for :breadcrumb do %>
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Dashboard", admin_root_path %></li>
    <li class="breadcrumb-item"><%= link_to "Usuários", admin_users_path %></li>
    <li class="breadcrumb-item"><%= link_to @user.display_name, admin_user_path(@user) %></li>
    <li class="breadcrumb-item active">Editar</li>
  </ol>
<% end %>

<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">Editar Usuário</h5>
      </div>
      <div class="card-body">
        <%= render "form", user: @user %>
      </div>
    </div>
  </div>
</div>

<