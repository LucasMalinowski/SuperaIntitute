<article class="card">
  <% if role.image.attached? %>
    <%= image_tag role.image.variant(resize_to_limit: [600, 400]), class: 'w-full h-40 object-cover' %>
  <% end %>
  <div class="p-4">
    <h2 class="text-xl font-semibold mb-2"><%= link_to role.name, role_path(role) %></h2>
    <p class="text-gray-600 dark:text-gray-400 mb-2"><%= role.company %> – <%= role.location %></p>
    <p class="text-sm mb-4"><%= truncate(role.description.to_plain_text, length: 100) %></p>
  </div>
</article>