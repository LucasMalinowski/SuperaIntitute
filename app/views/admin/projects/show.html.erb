<% content_for :page_title, @project.name %>
<% content_for :breadcrumb do %>
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Dashboard", admin_root_path %></li>
    <li class="breadcrumb-item"><%= link_to "Projetos", admin_projects_path %></li>
    <li class="breadcrumb-item active"><%= @project.name %></li>
  </ol>
<% end %>

<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Detalhes do Projeto</h5>
        <div class="btn-group">
          <%= link_to edit_admin_project_path(@project), class: "btn btn-outline-primary btn-sm" do %>
            <i class="bi bi-pencil me-2"></i>Editar
          <% end %>
          <%= link_to admin_project_path(@project), method: :delete,
                      data: { confirm: "Tem certeza que deseja excluir este projeto?" },
                      class: "btn btn-outline-danger btn-sm" do %>
            <i class="bi bi-trash me-2"></i>Excluir
          <% end %>
        </div>
      </div>
      <div class="card-body">
        <% if @project.image.attached? %>
          <div class="mb-4">
            <%= image_tag @project.image, class: "img-fluid rounded", style: "max-height: 300px;" %>
          </div>
        <% end %>

        <div class="mb-3">
          <label class="form-label fw-semibold">Descrição</label>
          <p><%= simple_format(@project.description) %></p>
        </div>

        <div class="row">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Local</label>
            <p><i class="bi bi-geo-alt me-2"></i><%= @project.location %></p>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Contato</label>
            <p><i class="bi bi-envelope me-2"></i><%= @project.contact %></p>
          </div>
        </div>

        <% if @project.date %>
          <div class="mb-3">
            <label class="form-label fw-semibold">Data de Conclusão</label>
            <p><i class="bi bi-calendar me-2"></i><%= @project.formatted_date %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card">
      <div class="card-header">
        <h6 class="mb-0">Informações</h6>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <label class="form-label fw-semibold">Status</label>
          <div>
            <% if @project.published? %>
              <span class="badge bg-success">Publicado</span>
            <% else %>
              <span class="badge bg-secondary">Rascunho</span>
            <% end %>
            <span class="badge bg-<%= @project.upcoming? ? 'primary' : 'success' %> ms-1">
              <%= @project.upcoming? ? 'Ativo' : 'Concluído' %>
            </span>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold">Criado por</label>
          <p class="mb-0"><%= @project.creator.display_name %></p>
          <small class="text-muted"><%= @project.created_at.strftime('%d/%m/%Y às %H:%M') %></small>
        </div>

        <% if @project.updated_at != @project.created_at %>
          <div class="mb-3">
            <label class="form-label fw-semibold">Última atualização</label>
            <p class="mb-0"><small class="text-muted"><%= @project.updated_at.strftime('%d/%m/%Y às %H:%M') %></small></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
