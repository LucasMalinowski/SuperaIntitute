<!DOCTYPE html>
<html>
<head>
  <title>Instituto Supera</title>
  <style>
      body {
          background-color: #ffffff;
          margin: 0;
          padding: 0;
      }
      .header {
          background-color: #002d70;
          color: #ffffff;
          text-align: center;
          padding: 20px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          flex-direction: row;
      }
      .header img {
          max-width: 100px;
          height: auto;
          border: 10px;
          border-color: red;
      }
      .links{
          display: flex;
          flex-direction: row;
          justify-content: space-between;
          width: 35%;
      }

      .footer {
          background-color: #002d70;
          color: #ffffff;
          text-align: center;
          padding: 20px 0;
      }
      .icons {
          font-size: 33px;
      }
  </style>
</head>
<body>
<div class="header">
  <%= image_tag("logo 1.png", alt: "Instituto Supera Logo") %>
  <div class="links">
    <h3>Projetos</h3>
    <h3>Eventos</h3>
    <h3>Vagas</h3>
    <h3>Contato</h3>
    <i class="fa-brands fa-instagram icons" style="color: #ffffff;"></i>
    <i class="fa-solid fa-envelope icons" style="color: #ffffff;"></i>
    <i class="fa-brands fa-whatsapp icons" style="color: #ffffff;"></i>
    <% if user_signed_in? %>
      <%= link_to admin_path do %>
        <i class="fa-solid fa-gears icons" style="color: #ffffff;"></i>
      <% end %>
    <% end %>
  </div>
</div>

<div class="container">
  <p class="notice"><%= notice %></p>
  <p class="alert"><%= alert %></p>

   Your main content goes here -->
  <%= render "events_partial" %>
</div>

<div class="footer">
  <p>Contact us: contact@institutosupera.org</p>
  <p>Address: 123 Example Street, City</p>
  Add more placeholders for other information -->
</div>
</body>
</html>

