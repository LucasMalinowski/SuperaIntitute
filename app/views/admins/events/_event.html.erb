<div id="<%= dom_id event %>" class="card">
  <p>
    <strong>Name:</strong>
    <%= event.name %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= event.description %>
  </p>

  <p>
    <strong>Date:</strong>
    <%= event.date %>
  </p>

  <p>
    <strong>Location:</strong>
    <%= event.location %>
  </p>
</div>

<style>


    .card {
        background-color: #f0f0f0;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        margin: 16px;
        padding: 16px;
        width: 300px;
    }

    .card p {
        margin: 8px 0;
    }

    .card strong {
        font-weight: bold;
    }
</style>