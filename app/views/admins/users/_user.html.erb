<div id="<%= dom_id user %>" class="user-card">
  <p class="user-info">
    <strong>Email:</strong>
    <%= user.email %>
  </p>
  <p class="user-info">
    <strong>Nome:</strong>
    <%= user.name %>
  </p>
  <br>
  <div class="user-actions">
    <%= link_to 'Editar', admins_edit_user_path(user), class: 'edit-button' %>
    <%= link_to 'Deletar', admins_destroy_user_path(user), method: :delete, class: 'delete-button' %>
  </div>

</div>
<style>
  .hidden {
      display: none;
  }

  .user-card {
      border: 1px solid #ddd;
      padding: 10px;
      margin: 10px;
      border-radius: 8px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      max-width: 300px;
      display: flex;
      flex-direction: column;
  }

  .user-info {
      margin: 8px 0;
  }

  .user-actions {
      margin-top: 10px;
      align-items: end;
  }

  .edit-button, .delete-button {
      background-color: #4CAF50;
      color: white;
      padding: 8px 12px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      margin-right: 8px;
  }

  .delete-button {
      background-color: #f44336;
  }

  .edit-button:hover, .delete-button:hover {
      background-color: #45a049;
  }

  strong {
      margin-right: 8px;
  }

</style>
