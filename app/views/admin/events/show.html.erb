<% content_for :page_title, @event.name %>
<% content_for :breadcrumb do %>
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Dashboard", admin_root_path %></li>
    <li class="breadcrumb-item"><%= link_to "Eventos", admin_events_path %></li>
    <li class="breadcrumb-item active"><%= @event.name %></li>
  </ol>
<% end %>

<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Detalhes do Evento</h5>
        <div class="d-flex gap-2">
          <%= link_to edit_admin_event_path(@event), class: "btn btn-outline-primary btn-sm" do %>
            <i class="bi bi-pencil me-2"></i>Editar
          <% end %>
          <%= button_to admin_event_path(@event), method: :delete,
                      data: { confirm: "Tem certeza que deseja excluir este evento?" },
                      class: "btn btn-outline-danger btn-sm" do %>
            <i class="bi bi-trash me-2"></i>Excluir
          <% end %>
        </div>
      </div>
      <div class="card-body">
        <% if @event.images.attached? %>
          <% @event.images.each do |image| %>
            <div class="mb-4">
              <% if image.blob.content_type.start_with?("image/") %>
                <%= image_tag image, class: "img-fluid rounded" %>
              <% elsif image.blob.content_type.start_with?("video/") %>
                <%= video_tag url_for(image),
                              controls: true,
                              preload: "metadata",
                              width: 180,
                              class: "rounded" %>
              <% end %>
            </div>
          <% end %>
        <% end %>

        <div class="mb-3">
          <label class="form-label fw-semibold">Descrição</label>
          <p><%= simple_format(@event.description) %></p>
        </div>

        <div class="row">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Data e Hora</label>
            <p><i class="bi bi-calendar-event me-2"></i><%= @event.formatted_date %></p>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Local</label>
            <p><i class="bi bi-geo-alt me-2"></i><%= @event.location %></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card">
      <div class="card-header">
        <h6 class="mb-0">Informações</h6>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <label class="form-label fw-semibold">Status</label>
          <div>
            <% if @event.published? %>
              <span class="badge bg-success">Publicado</span>
            <% else %>
              <span class="badge bg-secondary">Rascunho</span>
            <% end %>
            <span class="badge bg-<%= @event.upcoming? ? 'primary' : 'secondary' %> ms-1">
              <%= @event.upcoming? ? 'Próximo' : 'Passado' %>
            </span>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold">Criado por</label>
          <p class="mb-0"><%= @event.creator.display_name %></p>
          <small class="text-muted"><%= @event.created_at.strftime('%d/%m/%Y às %H:%M') %></small>
        </div>

        <% if @event.updated_at != @event.created_at %>
          <div class="mb-3">
            <label class="form-label fw-semibold">Última atualização</label>
            <p class="mb-0"><small class="text-muted"><%= @event.updated_at.strftime('%d/%m/%Y às %H:%M') %></small></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

