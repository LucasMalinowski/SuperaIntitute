<% content_for :title, @event.name %>

<section class="py-8">
  <div class="container mx-auto max-w-3xl">
    <h1 class="text-3xl font-bold mb-4"><%= @event.name %></h1>
    <p class="text-gray-600 dark:text-gray-400 mb-2">
      <time datetime="<%= @event.starts_at.iso8601 %>"><%= l(@event.starts_at, format: :long) %></time>
      –
      <time datetime="<%= @event.ends_at.iso8601 %>"><%= l(@event.ends_at, format: :long) %></time>
    </p>
    <p class="mb-4"><%= simple_format(@event.description.body.to_s) %></p>
    <p class="font-semibold"><%= @event.location %></p>
    <div class="mt-6 flex space-x-3">
      <%= link_to t('buttons.edit'), edit_admin_event_path(@event), class: 'btn-secondary' %>
      <%= button_to t('buttons.delete'), admin_event_path(@event), method: :delete, data: { turbo_confirm: t('buttons.confirm_destroy') }, class: 'btn-secondary' %>
    </div>
  </div>
</section>