<% content_for :page_title, "Editar Vaga" %>
<% content_for :breadcrumb do %>
	<ol class="breadcrumb">
		<li class="breadcrumb-item"><%= link_to "Dashboard", admin_root_path %></li>
		<li class="breadcrumb-item"><%= link_to "Vagas", admin_roles_path %></li>
		<li class="breadcrumb-item"><%= link_to @role.name, admin_role_path(@role) %></li>
		<li class="breadcrumb-item active">Editar</li>
	</ol>
<% end %>

<div class="row justify-content-center">
	<div class="col-md-10">
		<div class="card">
			<div class="card-header">
				<h5 class="mb-0">Editar Vaga</h5>
			</div>
			<div class="card-body">
				<%= render "form", role: @role %>
			</div>
		</div>
	</div>
</div>

