<div id="<%= dom_id project %>" class="card mb-3">
  <div class="card-body">
    <h5 class="card-title"><strong>Nome:</strong> <%= project.name %></h5>

    <p><strong>Descrição:</strong> <%= project.description %></p>
    <p><strong>Data:</strong> <%= I18n.l(project.date, format: :long) %>
      <span class="<%= project.upcoming? ? 'text-success' : 'text-danger' %>">
        <%= project.upcoming? ? 'Ativo' : 'Passado' %>
      </span>
    </p>
    <p><strong>Localização:</strong> <%= project.location %></p>
    <p><strong>Contato:</strong> <%= project.contact %></p>
  </div>

  <div class="card-footer d-flex justify-content-between">
    <%= link_to t('buttons.edit'), edit_admins_project_path(project), class: "btn btn-warning btn-sm" %>
    <%= link_to t('buttons.back_to_projects'), admins_projects_path, class: "btn btn-outline-secondary btn-sm" %>
    <%= button_to t('buttons.destroy'), project, method: :delete, data: { confirm: t('buttons.confirm_destroy') }, class: "btn btn-danger btn-sm" %>
  </div>
</div>
