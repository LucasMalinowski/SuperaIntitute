<div id="<%= dom_id role %>" class="card mb-3">
  <div class="card-body">
    <h5 class="card-title"><strong>Vaga:</strong> <%= role.name %></h5>

    <p><strong>Descrição:</strong> <%= role.description %></p>
    <p><strong>Salário:</strong> <%= number_to_currency(role.salary) %></p>
    <p><strong>Contato:</strong> <%= role.contact %></p>
    <p><strong>Endereço:</strong> <%= role.location %></p>
    <p><strong>Empresa:</strong> <%= role.company %></p>
    <p><strong>Email:</strong> <%= role.email %></p>
    <p><strong>Benefícios:</strong> <%= role.benefits %></p>
    <p><strong>Requisitos:</strong> <%= role.requirements %></p>
  </div>

  <div class="card-footer d-flex justify-content-between">
    <%= link_to t('buttons.edit'), edit_admins_role_path(role), class: "btn btn-warning btn-sm" %>
    <%= link_to t('buttons.back_to_roles'), admins_roles_path, class: "btn btn-outline-secondary btn-sm" %>
    <%= button_to t('buttons.destroy'), role, method: :delete, data: { confirm: t('buttons.confirm_destroy') }, class: "btn btn-danger btn-sm" %>
  </div>
</div>
