<div class="container">
	<p class="text-success"><%= notice %></p>

	<h1 class="my-4">Eventos</h1>
	<%= link_to "Novo evento", new_admins_event_path, class: "btn btn-dark mb-3" %>

	<div id="admins_events" class="row">
		<% @admins_events.each do |admins_event| %>
			<div class="col-md-6 col-lg-4">
				<%= render admins_event %>
			</div>
		<% end %>
	</div>
</div>
