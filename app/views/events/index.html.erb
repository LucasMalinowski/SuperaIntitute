<% content_for :title, t('navigation.events') %>

<section class="py-8">
  <div class="container mx-auto">
    <h1 class="text-3xl font-bold mb-6"><%= t('navigation.events') %></h1>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <%= render @events %>
    </div>
    <div class="mt-8">
      <%= paginate @events, theme: 'tailwind' %>
    </div>
  </div>
</section>