<div class="modal-dialog modal-lg l modal-dialog-centered mx-auto text-center" role="document">
  <div class="modal-content">
    <div class="modal-header">
      <%= image_tag municipe.image, size: 150 %>

      <h5 class="modal-title" id="municipeModalLabel"><%= municipe.name %></h5>
      <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>

    <div class="modal-body row">
      <div class="col-md-6">
        <ul class="list-group list-group-flush">
          <li class="list-group-item">
            <strong>Cpf:</strong> <%= municipe.cpf %>
          </li>
          <li class="list-group-item">
            <strong>Cns:</strong> <%= municipe.cns %>
          </li>
          <li class="list-group-item">
            <strong>Email:</strong> <%= municipe.email %>
          </li>
          <li class="list-group-item">
            <strong>Birth:</strong> <%= municipe.birthday %>
          </li>
          <li class="list-group-item">
            <strong>Phone:</strong> <%= municipe.phone %>
          </li>
        </ul>
      </div>
      <div class="col-md-6">
        <strong>Address:</strong>
        <% municipe.addresses.each do |address| %>
          <p>
            <%= address.street %>, <%= address.complement %>, <%= address.neighborhood %>, <%= address.city %>, <%= address.uf %>, <%= address.cep %>
            <%= link_to address do
              "<i class='fa fa-trash'></i>".html_safe
            end %>
          </p>
        <% end %>
      </div>
    </div>
    <div class="modal-footer">
      <%= link_to 'Close', '#', class: 'btn btn-secondary', data: { dismiss: 'modal' } %>
    </div>
  </div>
</div>
