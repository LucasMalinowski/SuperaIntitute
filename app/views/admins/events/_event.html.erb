<div id="<%= dom_id event %>" class="card mb-3 mt-5">
  <div class="card-body">
    <p><strong>Nome:</strong> <%= event.name %></p>
    <p><strong>Descrição:</strong> <%= event.description %></p>
    <p>
      <strong>Data:</strong> <%= I18n.l(event.date, format: :long) %>
      <span class="<%= event.upcoming? ? 'text-success' : 'text-danger' %>">
        <%= event.upcoming? ? 'Ativo' : 'Passado' %>
      </span>
    </p>
    <p><strong>Localização:</strong> <%= event.location %></p>
  </div>
</div>

<div class="actions d-flex">
  <%= link_to t('buttons.edit'), edit_admins_event_path(event), class: "btn btn-dark mx-3" %>
  <%= button_to t('buttons.destroy'), event, method: :delete, data: { confirm: t('buttons.confirm_destroy') }, class: "btn btn-danger" %>
</div>
