<% content_for :title, t('navigation.events') %>

<section class="py-8">
  <div class="container mx-auto">
    <div class="flex justify-between items-center mb-4">
      <h1 class="text-2xl font-bold"><%= t('navigation.events') %></h1>
      <%= link_to t('events.new'), new_admin_event_path, class: 'btn-primary' %>
    </div>
    <%= turbo_frame_tag 'admin_events' do %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <%= render @events %>
      </div>
      <div class="mt-6">
        <%= paginate @events, theme: 'tailwind' %>
      </div>
    <% end %>
  </div>
</section>