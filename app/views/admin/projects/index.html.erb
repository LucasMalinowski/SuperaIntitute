<% content_for :page_title, "Projetos" %>
<% content_for :breadcrumb do %>
	<ol class="breadcrumb">
		<li class="breadcrumb-item"><%= link_to "Dashboard", admin_root_path %></li>
		<li class="breadcrumb-item active">Projetos</li>
	</ol>
<% end %>

<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<p class="text-muted mb-0">Gerencie todos os projetos do sistema</p>
	</div>
	<%= link_to new_admin_project_path, class: "btn btn-primary" do %>
		<i class="bi bi-plus-lg me-2"></i>Novo Projeto
	<% end %>
</div>

<div class="card">
	<div class="card-body">
		<% if @projects.any? %>
			<div class="table-responsive">
				<table class="table table-hover">
					<thead>
					<tr>
						<th>Nome</th>
						<th>Data</th>
						<th>Local</th>
						<th>Contato</th>
						<th>Status</th>
						<th>Criado por</th>
						<th class="text-end">Ações</th>
					</tr>
					</thead>
					<tbody>
					<% @projects.each do |project| %>
						<tr>
							<td>
								<strong><%= project.name %></strong>
								<br>
								<small class="text-muted"><%= truncate(project.description, length: 60) %></small>
							</td>
							<td>
								<%= project.formatted_date %>
							</td>
							<td><%= project.location %></td>
							<td><%= project.contact %></td>
							<td>
								<% if project.published? %>
									<span class="badge bg-success">Publicado</span>
								<% else %>
									<span class="badge bg-secondary">Rascunho</span>
								<% end %>
								<br>
								<span class="badge bg-<%= project.upcoming? ? 'primary' : 'success' %> mt-1">
									<%= project.upcoming? ? 'Ativo' : 'Concluído' %>
								</span>
							</td>
							<td><%= project.creator.display_name %></td>
							<td class="text-end">
								<div class="d-flex gap-1" role="group">
									<%= link_to admin_project_path(project), class: "btn btn-sm btn-outline-primary" do %>
										<i class="bi bi-eye"></i>
									<% end %>
									<%= link_to edit_admin_project_path(project), class: "btn btn-sm btn-outline-secondary" do %>
										<i class="bi bi-pencil"></i>
									<% end %>
									<%= button_to admin_project_path(project), method: :delete,
															data: { confirm: "Tem certeza que deseja excluir este projeto?" },
															class: "btn btn-sm btn-outline-danger" do %>
										<i class="bi bi-trash"></i>
									<% end %>
								</div>
							</td>
						</tr>
					<% end %>
					</tbody>
				</table>
			</div>
		<% else %>
			<div class="text-center py-5">
				<i class="bi bi-folder-x" style="font-size: 4rem; color: var(--admin-secondary);"></i>
				<h4 class="mt-3">Nenhum projeto encontrado</h4>
				<p class="text-muted mb-4">Comece criando seu primeiro projeto</p>
				<%= link_to new_admin_project_path, class: "btn btn-primary" do %>
					<i class="bi bi-plus-lg me-2"></i>Criar Projeto
				<% end %>
			</div>
		<% end %>
	</div>
</div>
