<%= form_with(model: admins_role, local: true) do |form| %>
  <% if admins_role.errors.any? %>
    <div class="alert alert-danger">
      <h2><%= pluralize(admins_role.errors.count, "erro") %> impedem esta vaga de ser salva:</h2>
      <ul>
        <% admins_role.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= form.label :company, class: "form-label" %>
    <%= form.text_field :company, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, class: "form-control", rows: 3 %>
  </div>

  <div class="mb-3">
    <%= form.label :location, class: "form-label" %>
    <%= form.text_field :location, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :salary, class: "form-label" %>
    <%= form.text_field :salary, class: "form-control salary-input", pattern: "[0-9]*", title: "Somente números" %>
  </div>

  <div class="mb-3">
    <%= form.label :contact, class: "form-label" %>
    <%= form.text_field :contact, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :email, class: "form-label" %>
    <%= form.text_field :email, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :benefits, class: "form-label" %><br>
    <% Admins::Role::POSSIBLE_BENEFITS.each do |benefit| %>
      <%= form.check_box :benefits, { multiple: true }, benefit, nil %>
      <%= form.label :benefits, benefit.humanize %><br>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :requirements, class: "form-label" %>
    <%= form.text_field :requirements, class: "form-control" %>
  </div>

  <div class="d-grid">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>

<script>
  $(document).ready(function() {
    $('.salary-input').on('input', function() {
      if ($(this).val().charAt(0) != '$'){
        $(this).val('$' + $(this).val());
      }
    });

    $('.salary-input').on('blur', function() {
      if ($(this).val().charAt(0) == '$'){
        $(this).val($(this).val().substring(1));
      }
    });

  });
</script>
