<section class="py-5 bg-secondary-custom" id="vagas">
  <div class="container">
    <!-- Section Title -->
    <div class="text-center mb-5">
      <div class="d-inline-block position-relative">
        <span class="text-primary-custom fw-normal fs-6 px-4 position-relative">
          Vagas
          </span>
      </div>
      <h2 class="display-5 fw-bold text-dark mt-3 mb-0">Vagas Disponíveis</h2>
    </div>

    <!-- Jobs Grid -->
    <div class="row g-4">
      <% @roles&.each do |role| %>
        <div class="col-sm-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm bg-white">
            <div class="card-body p-4">
              <h3 class="card-title h5 fw-bold text-dark mb-3 lh-base"><%= role.name %></h3>
              <div class="mb-3 p-3 bg-light rounded-3">
                <div class="fw-bold text-primary-custom fs-6 mb-1"><%= number_to_currency(role.salary) %></div>
                <small class="text-muted"><%= role.company %></small>
              </div>
              <ul class="list-unstyled mb-4">
                <% role.benefits.first(3).each do |benefit| %>
                  <li class="mb-2 d-flex align-items-start">
                    <i class="fas fa-check text-success me-2 mt-1 flex-shrink-0" style="font-size: 0.8rem;"></i>
                    <small class="lh-base"><%= benefit %></small>
                  </li>
                <% end %>
                <% if role.benefits.length > 3 %>
                  <li class="mb-2 d-flex align-items-start">
                    <i class="fas fa-ellipsis-h text-muted me-2 mt-1 flex-shrink-0" style="font-size: 0.8rem;"></i>
                    <small class="text-muted lh-base">e mais benefícios...</small>
                  </li>
                <% end %>
              </ul>
              <button type="button" class="btn btn-outline-primary btn-sm rounded-pill w-100" data-bs-toggle="modal" data-bs-target="#roleModal<%= role.id %>">
                Ver detalhes
              </button>
            </div>
          </div>
        </div>

        <!-- Modal -->
        <div class="modal fade" id="roleModal<%= role.id %>" tabindex="-1" aria-labelledby="roleModalLabel<%= role.id %>" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
              <div class="modal-header border-0 pb-2 bg-secondary-custom">
                <h5 class="modal-title fw-bold text-dark" id="roleModalLabel<%= role.id %>"><%= role.name %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body">
                <div class="row">
                  <div class="col-12 mb-3">
                    <div class="bg-light p-3 rounded-3">
                      <div class="row">
                        <div class="col-6">
                          <strong class="text-dark d-block small">Salário:</strong>
                          <span class="text-primary-custom fw-bold"><%= number_to_currency(role.salary) %></span>
                        </div>
                        <div class="col-6">
                          <strong class="text-dark d-block small">Empresa:</strong>
                          <span class="text-muted"><%= role.company %></span>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="col-12">
                    <strong class="text-dark d-block mb-3">Benefícios:</strong>
                    <div class="row">
                      <% role.benefits.each do |benefit| %>
                        <div class="col-12 col-md-6 mb-2">
                          <div class="d-flex align-items-start">
                            <i class="fas fa-check text-success me-2 mt-1 flex-shrink-0" style="font-size: 0.8rem;"></i>
                            <small class="lh-base"><%= benefit %></small>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
              <div class="modal-footer border-0 bg-secondary-custom">
                <button type="button" class="btn btn-secondary btn-sm rounded-pill" data-bs-dismiss="modal">Fechar</button>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>